name: Build ModMenu APK
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Download base APK (release tag "base")
        run: |
          gh release download base --repo "$GITHUB_REPOSITORY" --pattern '*.apk' --output input.apk --clobber
          ls -la input.apk

      - name: Write sources
        run: |
          mkdir -p src/native src/java/com/modmenu src/tools
          cat > src/native/modmenu.cpp <<'EOF_CPP'
          #include <jni.h>
          #include <android/log.h>
          #include <dlfcn.h>
          #include <pthread.h>
          #include <unistd.h>
          #include <string.h>
          #include <stdio.h>
          #include <stdint.h>
          #include <stdarg.h>

          #define LOG(...) __android_log_print(ANDROID_LOG_INFO, "ModMenu", __VA_ARGS__)

          static char g_status[200] = "baslatiliyor";
          static void status(const char* fmt, ...) {
              va_list ap;
              va_start(ap, fmt);
              vsnprintf(g_status, sizeof(g_status), fmt, ap);
              va_end(ap);
              LOG("%s", g_status);
          }

          // 0 stamina, 1 bsoda, 2 baldi, 3 collect (one-shot)
          static volatile int g_stamina = 0, g_bsoda = 0, g_baldi = 0, g_collect = 0;
          static volatile int g_ready = 0;

          // ---- il2cpp api (resolved at runtime with dlsym) ----
          static void*       (*p_domain_get)(void);
          static void**      (*p_domain_get_assemblies)(void*, size_t*);
          static void*       (*p_assembly_get_image)(void*);
          static const char* (*p_image_get_name)(void*);
          static void*       (*p_class_from_name)(void*, const char*, const char*);
          static void*       (*p_class_get_method)(void*, const char*, int);
          static void*       (*p_class_get_field)(void*, const char*);
          static void        (*p_field_get_value)(void*, void*, void*);
          static void        (*p_field_set_value)(void*, void*, void*);
          static void*       (*p_runtime_invoke)(void*, void*, void**, void**);
          static void*       (*p_thread_attach)(void*);
          static void*       (*p_object_get_class)(void*);

          // ---- game metadata ----
          static void *f_player, *f_baldiScrpt, *f_notebooks, *f_maxNotebooks;
          static void *f_item, *f_itemSelected, *f_itemNames, *f_itemSlot, *f_itemTextures;
          static void *f_stamina, *f_maxStamina;
          static void *m_collect, *m_updateItemName, *m_getGameObject, *m_setActive;

          static const size_t PS = sizeof(void*);
          static int g_bsodaId = -2;      // -2 = not resolved yet, -1 = not found
          static void* g_lastGc = 0;
          static int g_baldiHidden = 0;

          typedef void (*UpdateFn)(void*, void*);
          static UpdateFn g_orig = 0;

          static int   getInt(void* o, void* f)   { int v = 0;      p_field_get_value(o, f, &v); return v; }
          static float getFloat(void* o, void* f) { float v = 0;    p_field_get_value(o, f, &v); return v; }
          static void* getPtr(void* o, void* f)   { void* v = 0;    p_field_get_value(o, f, &v); return v; }
          static void  setFloat(void* o, void* f, float v) { p_field_set_value(o, f, &v); }

          static int    arrLen(void* a)   { return a ? (int)*(uintptr_t*)((char*)a + 3 * PS) : 0; }
          static int*   intData(void* a)  { return (int*)((char*)a + 4 * PS); }
          static void** refData(void* a)  { return (void**)((char*)a + 4 * PS); }

          static void* invoke(void* m, void* obj, void** args) {
              void* exc = 0;
              return p_runtime_invoke(m, obj, args, &exc);
          }

          static void setActive(void* component, bool on) {
              void* go = invoke(m_getGameObject, component, 0);
              if (!go) return;
              bool b = on;
              void* args[1] = { &b };
              invoke(m_setActive, go, args);
          }

          static bool nameHasSoda(void* s) {
              if (!s) return false;
              int len = *(int32_t*)((char*)s + 2 * PS);
              const uint16_t* ch = (const uint16_t*)((char*)s + 2 * PS + 4);
              for (int i = 0; i + 4 <= len; i++) {
                  char c0 = ch[i] | 0x20, c1 = ch[i+1] | 0x20, c2 = ch[i+2] | 0x20, c3 = ch[i+3] | 0x20;
                  if (c0 == 's' && c1 == 'o' && c2 == 'd' && c3 == 'a') return true;
              }
              return false;
          }

          static void resolveBsoda(void* gc) {
              void* names = getPtr(gc, f_itemNames);
              g_bsodaId = -1;
              if (!names) return;
              int n = arrLen(names);
              for (int i = 0; i < n; i++) {
                  if (nameHasSoda(refData(names)[i])) { g_bsodaId = i; break; }
              }
              LOG("bsoda id = %d", g_bsodaId);
          }

          static void restoreItem(void* gc, void* items, int sel, int id) {
              intData(items)[sel] = id;
              void* slots = getPtr(gc, f_itemSlot);
              void* texs  = getPtr(gc, f_itemTextures);
              if (slots && texs && sel < arrLen(slots) && id < arrLen(texs)) {
                  void* raw = refData(slots)[sel];
                  void* tex = refData(texs)[id];
                  if (raw && tex) {
                      void* k = p_object_get_class(raw);
                      void* m = k ? p_class_get_method(k, "set_texture", 1) : 0;
                      if (m) { void* a[1] = { tex }; invoke(m, raw, a); }
                  }
              }
              if (m_updateItemName) invoke(m_updateItemName, gc, 0);
          }

          // Hook for GameControllerScript.Update (runs on the Unity main thread every frame)
          static void hk_update(void* self, void* mi) {
              if (!g_ready) { g_orig(self, mi); return; }
              if (self != g_lastGc) { g_lastGc = self; g_baldiHidden = 0; }

              int selBefore = -1, idBefore = -1;
              if (g_bsoda) {
                  if (g_bsodaId == -2) resolveBsoda(self);
                  void* items = getPtr(self, f_item);
                  if (items && g_bsodaId >= 0) {
                      int sel = getInt(self, f_itemSelected);
                      if (sel >= 0 && sel < arrLen(items)) { selBefore = sel; idBefore = intData(items)[sel]; }
                  }
              }

              g_orig(self, mi);

              if (selBefore >= 0 && idBefore == g_bsodaId) {
                  void* items = getPtr(self, f_item);
                  if (items && selBefore < arrLen(items) && intData(items)[selBefore] != idBefore)
                      restoreItem(self, items, selBefore, idBefore);
              }

              if (g_stamina) {
                  void* pl = getPtr(self, f_player);
                  if (pl) setFloat(pl, f_stamina, getFloat(pl, f_maxStamina));
              }

              void* baldi = getPtr(self, f_baldiScrpt);
              if (baldi) {
                  if (g_baldi && !g_baldiHidden)      { setActive(baldi, false); g_baldiHidden = 1; }
                  else if (!g_baldi && g_baldiHidden) { setActive(baldi, true);  g_baldiHidden = 0; }
              }

              if (g_collect) {
                  g_collect = 0;
                  int nb = getInt(self, f_notebooks);
                  int mx = getInt(self, f_maxNotebooks);
                  if (mx <= 0 || mx > 50) mx = 7;
                  for (int i = 0; i < mx - nb && i < 50; i++) invoke(m_collect, self, 0);
              }
          }

          static void* findImage(const char* a, const char* b) {
              void* dom = p_domain_get();
              if (!dom) return 0;
              size_t n = 0;
              void** as = p_domain_get_assemblies(dom, &n);
              for (size_t i = 0; i < n; i++) {
                  void* img = p_assembly_get_image(as[i]);
                  const char* nm = img ? p_image_get_name(img) : 0;
                  if (nm && (strcmp(nm, a) == 0 || strcmp(nm, b) == 0)) return img;
              }
              return 0;
          }

          #define LOADSYM(var, name) do { *(void**)&var = dlsym(h, name); if (!var) { status("sembol yok: %s", name); return 0; } } while (0)
          #define NEED(x, what) do { if (!(x)) { status("bulunamadi: %s", what); return 0; } } while (0)

          static void* worker(void*) {
              void* h = 0;
              for (int i = 0; i < 600 && !h; i++) {
                  h = dlopen("libil2cpp.so", RTLD_NOW | RTLD_NOLOAD);
                  if (!h) usleep(500000);
              }
              if (!h) { status("libil2cpp.so yuklenmedi"); return 0; }

              LOADSYM(p_domain_get, "il2cpp_domain_get");
              LOADSYM(p_domain_get_assemblies, "il2cpp_domain_get_assemblies");
              LOADSYM(p_assembly_get_image, "il2cpp_assembly_get_image");
              LOADSYM(p_image_get_name, "il2cpp_image_get_name");
              LOADSYM(p_class_from_name, "il2cpp_class_from_name");
              LOADSYM(p_class_get_method, "il2cpp_class_get_method_from_name");
              LOADSYM(p_class_get_field, "il2cpp_class_get_field_from_name");
              LOADSYM(p_field_get_value, "il2cpp_field_get_value");
              LOADSYM(p_field_set_value, "il2cpp_field_set_value");
              LOADSYM(p_runtime_invoke, "il2cpp_runtime_invoke");
              LOADSYM(p_thread_attach, "il2cpp_thread_attach");
              LOADSYM(p_object_get_class, "il2cpp_object_get_class");

              status("oyun motoru bekleniyor");
              void* dom = 0;
              for (int i = 0; i < 600 && !dom; i++) {
                  dom = p_domain_get();
                  if (!dom) usleep(500000);
              }
              NEED(dom, "il2cpp domain");
              sleep(3);
              p_thread_attach(dom);

              void* asm_cs = 0;
              void* core = 0;
              for (int i = 0; i < 240 && !(asm_cs && core); i++) {
                  asm_cs = findImage("Assembly-CSharp.dll", "Assembly-CSharp");
                  core   = findImage("UnityEngine.CoreModule.dll", "UnityEngine.CoreModule");
                  if (!(asm_cs && core)) usleep(500000);
              }
              NEED(asm_cs, "Assembly-CSharp");
              NEED(core, "UnityEngine.CoreModule");

              void* kGc = p_class_from_name(asm_cs, "", "GameControllerScript");
              void* kPl = p_class_from_name(asm_cs, "", "PlayerScript");
              void* kComp = p_class_from_name(core, "UnityEngine", "Component");
              void* kGo = p_class_from_name(core, "UnityEngine", "GameObject");
              NEED(kGc, "GameControllerScript");
              NEED(kPl, "PlayerScript");
              NEED(kComp, "Component");
              NEED(kGo, "GameObject");

              f_player = p_class_get_field(kGc, "player");              NEED(f_player, "gc.player");
              f_baldiScrpt = p_class_get_field(kGc, "baldiScrpt");      NEED(f_baldiScrpt, "gc.baldiScrpt");
              f_notebooks = p_class_get_field(kGc, "notebooks");        NEED(f_notebooks, "gc.notebooks");
              f_maxNotebooks = p_class_get_field(kGc, "maxNotebooks");  NEED(f_maxNotebooks, "gc.maxNotebooks");
              f_item = p_class_get_field(kGc, "item");                  NEED(f_item, "gc.item");
              f_itemSelected = p_class_get_field(kGc, "itemSelected");  NEED(f_itemSelected, "gc.itemSelected");
              f_itemNames = p_class_get_field(kGc, "itemNames");        NEED(f_itemNames, "gc.itemNames");
              f_itemSlot = p_class_get_field(kGc, "itemSlot");          NEED(f_itemSlot, "gc.itemSlot");
              f_itemTextures = p_class_get_field(kGc, "itemTextures");  NEED(f_itemTextures, "gc.itemTextures");
              f_stamina = p_class_get_field(kPl, "stamina");            NEED(f_stamina, "player.stamina");
              f_maxStamina = p_class_get_field(kPl, "maxStamina");      NEED(f_maxStamina, "player.maxStamina");

              m_collect = p_class_get_method(kGc, "CollectNotebook", 0);      NEED(m_collect, "CollectNotebook");
              m_updateItemName = p_class_get_method(kGc, "UpdateItemName", 0); NEED(m_updateItemName, "UpdateItemName");
              m_getGameObject = p_class_get_method(kComp, "get_gameObject", 0); NEED(m_getGameObject, "get_gameObject");
              m_setActive = p_class_get_method(kGo, "SetActive", 1);          NEED(m_setActive, "SetActive");
              void* mUpdate = p_class_get_method(kGc, "Update", 0);           NEED(mUpdate, "gc.Update");

              void** mi = (void**)mUpdate;      // MethodInfo: first field is methodPointer
              g_orig = (UpdateFn)mi[0];
              g_ready = 1;
              mi[0] = (void*)hk_update;
              status("hazir");
              return 0;
          }

          extern "C" {

          JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM*, void*) {
              pthread_t t;
              pthread_create(&t, 0, worker, 0);
              pthread_detach(t);
              return JNI_VERSION_1_6;
          }

          JNIEXPORT void JNICALL Java_com_modmenu_ModMenu_nSet(JNIEnv*, jclass, jint id, jint v) {
              switch (id) {
                  case 0: g_stamina = v; break;
                  case 1: g_bsoda = v; break;
                  case 2: g_baldi = v; break;
                  case 3: g_collect = v; break;
              }
          }

          JNIEXPORT jstring JNICALL Java_com_modmenu_ModMenu_nStatus(JNIEnv* env, jclass) {
              return env->NewStringUTF(g_status);
          }

          }
          EOF_CPP
          cat > src/java/com/modmenu/ModMenu.java <<'EOF_JAVA'
          package com.modmenu;

          import android.app.Activity;
          import android.graphics.Color;
          import android.graphics.drawable.GradientDrawable;
          import android.os.Handler;
          import android.os.Looper;
          import android.view.Gravity;
          import android.view.View;
          import android.widget.Button;
          import android.widget.CheckBox;
          import android.widget.CompoundButton;
          import android.widget.FrameLayout;
          import android.widget.LinearLayout;
          import android.widget.TextView;

          public final class ModMenu {
              private static boolean started = false;
              private static boolean loaded = false;

              private static native void nSet(int id, int value);
              private static native String nStatus();

              public static void init(final Activity activity) {
                  if (started) return;
                  started = true;
                  try {
                      System.loadLibrary("modmenu");
                      loaded = true;
                  } catch (Throwable t) {
                      loaded = false;
                  }
                  new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                      public void run() {
                          try { build(activity); } catch (Throwable t) { }
                      }
                  }, 1500);
              }

              private static int dp(Activity a, int v) {
                  return (int) (v * a.getResources().getDisplayMetrics().density + 0.5f);
              }

              private static void addToggle(final Activity a, LinearLayout panel, String text, final int id) {
                  CheckBox cb = new CheckBox(a);
                  cb.setText(text);
                  cb.setTextColor(Color.WHITE);
                  cb.setTextSize(15);
                  cb.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
                      public void onCheckedChanged(CompoundButton b, boolean checked) {
                          if (loaded) nSet(id, checked ? 1 : 0);
                      }
                  });
                  panel.addView(cb);
              }

              private static void build(final Activity a) {
                  final LinearLayout panel = new LinearLayout(a);
                  panel.setOrientation(LinearLayout.VERTICAL);
                  int pad = dp(a, 10);
                  panel.setPadding(pad, pad, pad, pad);
                  GradientDrawable bg = new GradientDrawable();
                  bg.setColor(Color.argb(210, 20, 20, 20));
                  bg.setCornerRadius(dp(a, 8));
                  panel.setBackground(bg);
                  panel.setVisibility(View.GONE);

                  final TextView st = new TextView(a);
                  st.setTextColor(Color.LTGRAY);
                  st.setTextSize(12);
                  panel.addView(st);

                  addToggle(a, panel, "Sınırsız stamina", 0);
                  addToggle(a, panel, "Sınırsız BSODA", 1);
                  addToggle(a, panel, "Baldi'yi sil", 2);

                  Button collect = new Button(a);
                  collect.setText("Tüm defterleri topla");
                  collect.setOnClickListener(new View.OnClickListener() {
                      public void onClick(View v) {
                          if (loaded) nSet(3, 1);
                      }
                  });
                  panel.addView(collect);

                  final Button toggle = new Button(a);
                  toggle.setText("MOD");
                  toggle.setTextSize(12);
                  toggle.setAlpha(0.75f);

                  final Handler h = new Handler(Looper.getMainLooper());
                  final Runnable refresh = new Runnable() {
                      public void run() {
                          if (panel.getVisibility() == View.VISIBLE) {
                              String s = loaded ? nStatus() : "native kutuphane yuklenemedi";
                              st.setText("Durum: " + s);
                              h.postDelayed(this, 1000);
                          }
                      }
                  };
                  toggle.setOnClickListener(new View.OnClickListener() {
                      public void onClick(View v) {
                          if (panel.getVisibility() == View.VISIBLE) {
                              panel.setVisibility(View.GONE);
                          } else {
                              panel.setVisibility(View.VISIBLE);
                              h.post(refresh);
                          }
                      }
                  });

                  FrameLayout.LayoutParams lpBtn = new FrameLayout.LayoutParams(dp(a, 64), dp(a, 40), Gravity.TOP | Gravity.END);
                  lpBtn.topMargin = dp(a, 8);
                  lpBtn.rightMargin = dp(a, 8);
                  FrameLayout.LayoutParams lpPanel = new FrameLayout.LayoutParams(
                          FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.END);
                  lpPanel.topMargin = dp(a, 54);
                  lpPanel.rightMargin = dp(a, 8);

                  a.addContentView(panel, lpPanel);
                  a.addContentView(toggle, lpBtn);
              }
          }
          EOF_JAVA
          cat > src/tools/patch_smali.py <<'EOF_PY1'
          import re, sys, glob, os
          launcher = 'com/unity3d/player/UnityPlayerActivity.smali'
          paths = glob.glob(os.path.join(sys.argv[1], 'smali*', launcher))
          if not paths:
              sys.exit('UnityPlayerActivity.smali bulunamadi')
          p = paths[0]
          s = open(p, encoding='utf-8').read()
          m = re.search(r'\.method (?:public|protected) onCreate\(Landroid/os/Bundle;\)V.*?\.end method', s, re.S)
          if not m:
              sys.exit('onCreate bulunamadi')
          body = m.group(0)
          call = '    invoke-static {p0}, Lcom/modmenu/ModMenu;->init(Landroid/app/Activity;)V\n'
          if 'Lcom/modmenu/ModMenu;' in body:
              print('zaten yamali'); sys.exit(0)
          idx = body.rfind('    return-void')
          if idx < 0:
              sys.exit('return-void bulunamadi')
          newbody = body[:idx] + call + body[idx:]
          open(p, 'w', encoding='utf-8').write(s.replace(body, newbody, 1))
          print('yamalandi:', p)
          EOF_PY1
          cat > src/tools/assemble.py <<'EOF_PY2'
          import sys, zipfile
          orig, built, javadex, lib, out = sys.argv[1:6]
          zo = zipfile.ZipFile(orig)
          zb = zipfile.ZipFile(built)
          newdex = zb.read('classes.dex')
          SIG = ('.SF', '.RSA', '.DSA', '.EC')
          with zipfile.ZipFile(out, 'w') as zw:
              for zi in zo.infolist():
                  n = zi.filename
                  if n.endswith('/'):
                      continue
                  if n.startswith('META-INF/') and (n.endswith(SIG) or n == 'META-INF/MANIFEST.MF'):
                      continue
                  if n == 'classes.dex':
                      data, ct = newdex, zipfile.ZIP_DEFLATED
                  else:
                      data, ct = zo.read(n), zi.compress_type
                  ni = zipfile.ZipInfo(n, date_time=zi.date_time)
                  ni.external_attr = zi.external_attr
                  zw.writestr(ni, data, compress_type=ct)
              for name, path, ct in (('classes2.dex', javadex, zipfile.ZIP_DEFLATED),
                                     ('lib/armeabi-v7a/libmodmenu.so', lib, zipfile.ZIP_STORED)):
                  ni = zipfile.ZipInfo(name, date_time=(1981, 1, 1, 1, 1, 1))
                  zw.writestr(ni, open(path, 'rb').read(), compress_type=ct)
          print('tamam')
          EOF_PY2

      - name: Build native library (armeabi-v7a)
        run: |
          NDK="${ANDROID_NDK_LATEST_HOME:-${ANDROID_NDK_HOME:-$ANDROID_NDK_ROOT}}"
          CXX="$NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang++"
          "$CXX" -shared -fPIC -O2 -std=c++17 -fno-exceptions -fno-rtti -static-libstdc++ \
            -o libmodmenu.so src/native/modmenu.cpp -llog -ldl
          ls -la libmodmenu.so

      - name: Build Java menu (dex)
        run: |
          BT="$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -1)"
          AJAR="$(ls -d "$ANDROID_HOME"/platforms/android-* | sort -V | tail -1)/android.jar"
          mkdir -p classes dexout
          javac -source 8 -target 8 -cp "$AJAR" -d classes src/java/com/modmenu/ModMenu.java
          "$BT/d8" --release --min-api 21 --lib "$AJAR" --output dexout classes/com/modmenu/*.class
          ls -la dexout

      - name: Patch launcher activity
        run: |
          curl -sSL -o apktool.jar https://github.com/iBotPeaches/Apktool/releases/download/v2.9.3/apktool_2.9.3.jar
          java -jar apktool.jar d -r -f input.apk -o dec
          python3 src/tools/patch_smali.py dec
          java -jar apktool.jar b dec -o built.apk
          ls -la built.apk

      - name: Assemble, align and sign
        run: |
          BT="$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -1)"
          python3 src/tools/assemble.py input.apk built.apk dexout/classes.dex libmodmenu.so merged.apk
          "$BT/zipalign" -p -f 4 merged.apk aligned.apk
          keytool -genkeypair -keystore ks.jks -storepass android -keypass android -alias mod \
            -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=ModMenu"
          "$BT/apksigner" sign --ks ks.jks --ks-pass pass:android --key-pass pass:android \
            --out BUNUN_TADINA_BAK_modmenu.apk aligned.apk
          "$BT/apksigner" verify BUNUN_TADINA_BAK_modmenu.apk
          ls -la BUNUN_TADINA_BAK_modmenu.apk

      - name: Publish release "modded"
        run: |
          gh release delete modded --yes --cleanup-tag --repo "$GITHUB_REPOSITORY" || true
          gh release create modded BUNUN_TADINA_BAK_modmenu.apk --repo "$GITHUB_REPOSITORY" \
            --title "Modmenulu APK" --notes "Releases sayfasindan APK'yi indir."
